# Homologação — copie para a raiz (smoke) ou para o servidor HMG:
#   cp docker/env.homolog.example .env.homolog
#   # HMG: /opt/jangada/.env.homolog
#
# NÃO versionar .env.homolog (já coberto por .gitignore .env.*)

# --- Ambiente ---
NODE_ENV=production
TZ=America/Fortaleza
PORT=3000
ALLOW_LOCAL_BYPASS=0

# URL pública/interna do Traefik (Auth.js)
AUTH_URL=http://homolog-jangada.cge.local
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=GERE_UMA_CHAVE_ALEATORIA_COM_PELO_MENOS_32_CARACTERES

# Google OAuth (opcional)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- PostgreSQL ASESI (mesmo servidor do Farol; schema isolado) ---
PG_HOST=192.168.3.26
PG_PORT=5432
PG_DATABASE=h_asesi
PG_USER=postgres
PG_PASSWORD=
PG_SCHEMA=trelloai
PG_SSL=0

# --- Maya / LiteLLM CGE ---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://litellm.cge.ce.gov.br
DEEPSEEK_MODEL=deepseek.v3.2

# OpenAI (opcional — assistente genérico do board)
OPENAI_API_KEY=

# --- Imagem (quando publicar em registry) ---
# JANGADA_IMAGE=nexus.cge.ce.gov.br/jangada:homol
