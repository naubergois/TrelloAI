# ─── AWS Secrets Manager (opcional) ───────────────────────────────────────────
# Se definido, o app busca secrets do AWS Secrets Manager na inicialização
# e injeta como env vars (sem sobrescrever valores já definidos localmente).
# O secret deve ser um JSON com chaves = nomes das env vars abaixo.
# AWS_SECRET_NAME=asesi/jangada/homol
# AWS_REGION=sa-east-1

# DeepSeek / LiteLLM CGE — Maya (gestor virtual)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
# Homologação CGE (preferir LiteLLM interno / Bedrock):
# DEEPSEEK_BASE_URL=https://litellm.cge.ce.gov.br
# DEEPSEEK_MODEL=deepseek.v3.2
# Bedrock não aceita temperature/response_format — o app omite automaticamente.
# DEEPSEEK_DROP_PARAMS=1
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# OpenAI (opcional) — assistente genérico do board
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Auth.js (obrigatório para login)
AUTH_SECRET=gera_com_openssl_rand_base64_32
AUTH_URL=http://localhost:3000

# Produção: desabilita ?local=1 (bypass de login)
# ALLOW_LOCAL_BYPASS=0

# Administrador inicial (cadastra os demais em /admin/usuarios)
ADMIN_EMAIL=admin@cge.ce.gov.br
ADMIN_PASSWORD=Jangada@Admin
ADMIN_NAME=Administrador
ADMIN_USERNAME=admin

# Persistência ASESI (PostgreSQL h_asesi, schema trelloai)
# Mesmo servidor do Farol; schema isolado — não usa o schema farol.
PG_HOST=192.168.3.26
PG_PORT=5432
PG_DATABASE=h_asesi
PG_USER=asesi_jangada
PG_PASSWORD=
PG_SCHEMA=trelloai
PG_SSL=0
# Alternativa: DATABASE_URL=postgres://asesi_jangada:SENHA@192.168.3.26:5432/h_asesi
