# DeepSeek — Maya (gestor virtual)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# OpenAI (opcional) — assistente genérico do board
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Auth.js (obrigatório para login)
AUTH_SECRET=gera_com_openssl_rand_base64_32
AUTH_URL=http://localhost:3000

# Produção: desabilita ?local=1 (bypass de login)
# ALLOW_LOCAL_BYPASS=0

# Persistência em nuvem (opcional — Postgres)
# DATABASE_URL=postgres://user:pass@host:5432/trelloai

# Google OAuth
# 1) Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web)
# 2) Authorized redirect URIs:
#    http://localhost:3000/api/auth/callback/google
# 3) Cole Client ID e Client Secret abaixo e reinicie o server
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
