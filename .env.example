# DeepSeek / LiteLLM CGE — Maya (gestor virtual)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
# Homologação CGE (preferir LiteLLM interno):
# DEEPSEEK_BASE_URL=https://litellm.cge.ce.gov.br
# DEEPSEEK_MODEL=deepseek.v3.2
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# OpenAI (opcional) — assistente genérico do board
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Auth.js (obrigatório para login)
AUTH_SECRET=gera_com_openssl_rand_base64_32
AUTH_URL=http://localhost:3000

# Produção: desabilita ?local=1 (bypass de login)
# ALLOW_LOCAL_BYPASS=0

# Persistência ASESI (PostgreSQL h_asesi, schema trelloai)
# Mesmo servidor do Farol; schema isolado — não usa o schema farol.
PG_HOST=192.168.3.26
PG_PORT=5432
PG_DATABASE=h_asesi
PG_USER=postgres
PG_PASSWORD=
PG_SCHEMA=trelloai
PG_SSL=0
# Alternativa: DATABASE_URL=postgres://postgres:SENHA@192.168.3.26:5432/h_asesi


# Google OAuth
# 1) Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web)
# 2) Authorized redirect URIs:
#    http://localhost:3000/api/auth/callback/google
# 3) Cole Client ID e Client Secret abaixo e reinicie o server
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
