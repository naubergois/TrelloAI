# Copie para .env.local e preencha. Não versione senhas, tokens nem dados reais.

# ─── AWS Secrets Manager (opcional) ───────────────────────────────────────────
# JSON no cofre com chaves = nomes das env vars. Não sobrescreve o que já está no ambiente.
# AWS_SECRET_NAME=
# AWS_REGION=sa-east-1

# DeepSeek / LiteLLM — Maya (gestora virtual)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# OpenAI (opcional) — assistente genérico do board
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Auth.js (obrigatório para login)
AUTH_SECRET=gera_com_openssl_rand_base64_32
AUTH_URL=http://localhost:3000

# Produção: desabilita ?local=1 (bypass de login)
# ALLOW_LOCAL_BYPASS=0

# Administrador inicial (cadastra os demais em /admin/usuarios)
# Defina uma senha forte no .env.local — não use valor de exemplo em produção.
ADMIN_EMAIL=admin@localhost
ADMIN_PASSWORD=
ADMIN_NAME=Administrador
ADMIN_USERNAME=admin

# MCP stdio (Cursor / Kiro)
# MCP_ACTOR_EMAIL=admin@localhost

# Git da Maya (opcional)
# GITLAB_TOKEN=
# GITHUB_TOKEN=
# MAYA_GIT_WEEKLY=1
# CRON_SECRET=

# PostgreSQL (deixe vazio para gravar só em data/ no desenvolvimento)
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=jangada
PG_USER=jangada
PG_PASSWORD=
PG_SCHEMA=trelloai
PG_SSL=0
# DATABASE_URL=postgres://jangada:SENHA@localhost:5432/jangada
